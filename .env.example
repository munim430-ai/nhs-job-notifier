# ─── Apify ────────────────────────────────────────────────────────────────────
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Actor ID for the NHS Jobs scraper (free community actor)
APIFY_ACTOR_ID=crawlerbros/nhs-jobs-scraper

# ─── Telegram Bot ──────────────────────────────────────────────────────────────
# Step 1: Message @BotFather on Telegram → /newbot → copy the token below
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Step 2: Send any message to your bot, then run:
#   node -e "require('./src/telegram').getChatId()"
# Supports multiple recipients — separate chat IDs with a comma (no spaces)
# e.g. your ID and your wife's ID: 7892901500,9876543210
TELEGRAM_CHAT_ID=987654321

# ─── Job Filters ───────────────────────────────────────────────────────────────
# Comma-separated keywords to match against job titles (blank = all jobs)
FILTER_KEYWORDS=nurse,midwife,healthcare assistant,staff nurse

# Minimum NHS pay band (1–9). Jobs below this band are skipped. (blank = any)
MIN_PAY_BAND=5

# Comma-separated locations to watch (blank = all of England)
FILTER_LOCATIONS=London,Birmingham,Manchester

# How many days back to look for new postings (default: 1)
LOOKBACK_DAYS=1

# ─── Webhook Server (optional — only needed for always-on mode) ────────────────
# Port the local Express server listens on
WEBHOOK_PORT=3000

# Shared secret to validate Apify's webhook calls (choose any random string)
WEBHOOK_SECRET=choose_a_random_secret_string_here
